@@ -0,0 +1,919 @@
+#!/bin/sh
+# =============================================================================
+# perf-metrics.sh
+#
+# 性能試験 (JMeter など) の間、JBoss EAP 8.1 / OpenJDK 21 (Red Hat build) を動かす
+# コンテナの中で次の 2 つだけを一定間隔で取得し、readonlyRootFilesystem=true でも
+# 書き込める EFS 上のタスク専用ディレクトリへ CSV で書き出す。
+#
+#   ① jboss-cli : DB 接続プール (データソースごとの statistics=pool と最小 / 最大プール)
+#                 ライブスレッド数 (JVM が数えるスレッド数) と、同じ時刻の OS スレッド数
+#                 (カーネルから見た JBoss プロセスのスレッド数。/proc/<pid>/status の Threads)
+#   ② jstat     : ヒープ各領域の容量・使用量と GC 回数・時間 (jstat -gc)
+#
+# 性能試験用の実装はこの 1 ファイルにまとめている。
+#   ビルド時: front / back の Dockerfile が、ビルド引数 PERF_METRICS_ENABLED=true の
+#             ときだけこのファイルを残し `perf-metrics.sh install` で必要なコマンドを確かめる。
+#             false (既定) ならファイルを削除する (本番と同じ中身になる)。
+#   起動時  : efs-entrypoint.sh が PERF_METRICS_ENABLED=true のときだけこのファイルを
+#             読み込み (.) perf_metrics_start を呼ぶ。収集は別プロセスで行い、
+#             JBoss の起動を待たせない。収集側で何が起きても JBoss の起動は止めない。
+#
+# 【出力先】 (readonlyRootFilesystem=true でも書き込める場所)
+#   JBoss のログと同じタスク専用ディレクトリの下の perf/ に書く。
+#     /mnt/logs/<Component_name>/logs/<Service_Name>/mid/<LOG_ID>/perf/
+#     例) /mnt/logs/front/logs/intra-web/mid/current/perf/
+#         (current はエントリポイントが「最後に起動したタスクの <LOG_ID>」へ張る目印)
+#   current は全タスクが共有して張り替えるリンクなので、書き込みの経路には使わない
+#   (server.log を実体パスへ固定 (pin) しているのと同じ理由。docs/LOG_ROTATION.md)。
+#   エントリポイントが決めた実体パス JBOSS_LOG_DIR (= mid/<LOG_ID>) を使い、取れない
+#   ときだけ起動時点の current を実体パスに解決して使う。
+#   FIFO・PID ファイルなどの作業ファイルはタスクローカルの書き込み可能領域
+#   (/tmp → standalone/tmp → 出力先/.work の順に、書けるところ) に置く。
+#
+# 【出力ファイル】 (UTF-8・LF・1 行目が見出しの CSV。timestamp はコンテナの TZ、epoch は UNIX 秒)
+#   cli_datasource.csv   ① データソース別 接続プール統計 (statistics=pool) と最小 / 最大プール
+#   jvm_threads.csv      ① ライブスレッド数・OS スレッド数 (jboss-cli が応答しないときも OS スレッド数は記録)
+#   jvm_jstat_gc.csv     ② jstat -gc (容量・使用量は KB、GC 時間は秒)
+#   perf_meta.csv        収集条件 (category,key,value)
+#   collector.log        収集プロセスのログ
+#
+# 【使い方】
+#   ビルド    : docker build --build-arg PERF_METRICS_ENABLED=true ... docker/front
+#   起動      : 何もしなくてよい (エントリポイントが起動時に読み込む)
+#   状態確認  : perf-metrics.sh status            (ECS Exec でコンテナに入って実行)
+#   停止      : perf-metrics.sh stop
+#   まとめる  : perf-metrics.sh pack              (perf/ を tar 1 ファイルにする)
+#   レポート  : perf/ を Windows に持ってきて New-PerfMetricsReport.ps1 で Excel にする
+#
+# 【設定】 (環境変数。ビルド時の ENV・タスク定義の environment のどちらでも指定できる)
+#   PERF_METRICS_ENABLED     true | false     収集するか (ビルド引数から ENV に焼き込む)
+#   PERF_INTERVAL            10               ① ② の既定の間隔 (秒)
+#   PERF_CLI_INTERVAL        PERF_INTERVAL    ① jboss-cli (DB 接続プール・スレッド数) の間隔 (秒)
+#   PERF_JSTAT_INTERVAL      PERF_INTERVAL    ② jstat の間隔 (秒)
+#   PERF_COLLECTORS          "cli jstat"      動かす収集 (空白区切り)
+#   PERF_OUTPUT_DIR          (自動)           出力先を明示するとき
+#   PERF_WORK_DIR            (自動)           作業ディレクトリを明示するとき
+#   PERF_TZ                  (コンテナの TZ)  タイムスタンプのタイムゾーン (例 Asia/Tokyo)
+#   PERF_ENABLE_STATISTICS   true             standalone.sh に -Dwildfly.datasources.statistics-enabled=true
+#                                             を足す (標準構成の式を使うデータソースは起動時から統計が有効)
+#   PERF_CLI_ENABLE_DS_STATS true             それでもプール統計が無効なデータソースを実行時に有効化する
+#                                             (statistics=pool の実行時属性。設定ファイルは変えず、
+#                                              再起動で元に戻る)
+#   PERF_CLI_CONTROLLER      (自動)           例 remote+http://127.0.0.1:9990
+#   PERF_CLI_USER / PERF_CLI_PASSWORD         ローカル認証が使えないときの管理ユーザー
+#   PERF_CLI_TIMEOUT         30               1 回の取得のタイムアウト (秒)
+#   PERF_CLI_HEAP            64m              jboss-cli の最大ヒープ
+#   PERF_WAIT_TIMEOUT        900              JBoss の JVM・管理インタフェースを待つ秒数 (JVM が現れなければ
+#                                             収集を終える。管理インタフェースは警告して 60 秒ごとに再試行)
+#
+# 【注意】
+#   - 収集用に jboss-cli (常駐 1 つ・最大ヒープ 64MB)、jstat (常駐 1 つ・32MB) の JVM が
+#     増える。RSS で合計 150〜200MB を見込み、タスクのメモリに余裕を持たせること。
+#   - jstat は JBoss が /tmp に作る性能カウンタ (hsperfdata) を読む。readonlyRootFilesystem=true
+#     では /tmp に書き込み可能ボリュームを当てること (当てないと ② は取れない。① は取れる)。
+#   - 本ファイルは /bin/sh (POSIX) で動く。エントリポイント (set -eu) から読み込まれる
+#     ため、トップレベルでは関数と既定値の定義しか行わない。
+# =============================================================================
+
+PERF_METRICS_VERSION="2.1.0"
+
+# --- 既定値 (エントリポイントから読み込まれても安全な代入だけ) ------------------
+: "${PERF_METRICS_ENABLED:=false}"
+: "${PERF_INTERVAL:=10}"
+: "${PERF_CLI_INTERVAL:=${PERF_INTERVAL}}"
+: "${PERF_JSTAT_INTERVAL:=${PERF_INTERVAL}}"
+: "${PERF_COLLECTORS:=cli jstat}"
+: "${PERF_OUTPUT_DIR:=}"
+: "${PERF_WORK_DIR:=}"
+: "${PERF_TZ:=}"
+: "${PERF_ENABLE_STATISTICS:=true}"
+: "${PERF_CLI_ENABLE_DS_STATS:=true}"
+: "${PERF_CLI_CONTROLLER:=}"
+: "${PERF_CLI_USER:=}"
+: "${PERF_CLI_PASSWORD:=}"
+: "${PERF_CLI_TIMEOUT:=30}"
+: "${PERF_CLI_HEAP:=64m}"
+: "${PERF_WAIT_TIMEOUT:=900}"
+
+# エントリポイントが standalone.sh の直後へ足す引数 (データソースの統計の有効化)。
+# 標準の構成のデータソースは
+#   statistics-enabled="${wildfly.datasources.statistics-enabled:${wildfly.statistics-enabled:false}}"
+# の式を使っているため、このシステムプロパティで起動時から統計が有効になる
+# (式を使っていないデータソースは ① が実行時に有効化する)。
+PERF_SERVER_OPTS=""
+if [ "${PERF_ENABLE_STATISTICS}" = "true" ]; then
+    PERF_SERVER_OPTS="-Dwildfly.datasources.statistics-enabled=true"
+fi
+
+PM_SELF="${PERF_METRICS_SCRIPT:-/usr/local/bin/perf-metrics.sh}"
+
+# 収集用の JVM (jboss-cli / jstat) に共通のオプション (小さく・速く起動する)
+PM_JVM_OPTS="-XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:-UsePerfData -Xss512k"
+
+# パスワードらしき値を伏せる (perf_meta.csv の起動コマンド用 sed 式)
+PM_MASK_SED='s/\([Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd][A-Za-z0-9_.-]*[=:]\)[^ ,]*/\1********/g'
+
+# =============================================================================
+# 共通ヘルパー
+# =============================================================================
+pm_say() {
+    printf '[perf-metrics] %s\n' "$*"
+}
+
+# ログ: collector.log へ。WARN / ERROR は標準エラー (CloudWatch Logs) にも出す。
+pm_log() {
+    _pm_ll="$(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null) [perf-metrics] [${PM_NAME:-main}] $1 $2"
+    if [ -n "${PM_LOG_FILE:-}" ]; then
+        printf '%s\n' "${_pm_ll}" >> "${PM_LOG_FILE}" 2>/dev/null
+    fi
+    case "$1" in
+        WARN|ERROR) printf '%s\n' "${_pm_ll}" >&2 ;;
+    esac
+    return 0
+}
+
+# 同じ警告を何度も出さない (キーごとに 1 回)
+pm_warn_once() {  # key message
+    case " ${PM_WARNED:-} " in
+        *" $1 "*) return 0 ;;
+    esac
+    PM_WARNED="${PM_WARNED:-} $1"
+    pm_log WARN "$2"
+}
+
+# 正の整数でなければ既定値に戻す
+pm_uint_or() {  # value default
+    case "$1" in
+        ""|*[!0-9]*) printf '%s' "$2" ;;
+        *) if [ "$1" -gt 0 ]; then printf '%s' "$1"; else printf '%s' "$2"; fi ;;
+    esac
+}
+
+# ディレクトリへ実際に書き込めるか (EROFS / EACCES の両方を実書き込みで判定)
+pm_is_writable() {
+    [ -d "$1" ] || return 1
+    _pm_probe="$1/.perf-metrics-writetest.$$"
+    if ( : > "${_pm_probe}" ) 2>/dev/null; then
+        rm -f "${_pm_probe}" 2>/dev/null
+        return 0
+    fi
+    return 1
+}
+
+# 現在時刻: PM_TS (YYYY-MM-DD HH:MM:SS) と PM_EPOCH (UNIX 秒)
+pm_now() {
+    _pm_n="$(date '+%Y-%m-%d %H:%M:%S|%s')"
+    PM_TS="${_pm_n%|*}"
+    PM_EPOCH="${_pm_n#*|}"
+}
+
+# 次の「間隔の倍数の時刻」まで待つ
+pm_sleep_tick() {  # interval
+    _pm_s="$(date +%s)"
+    sleep $(( $1 - _pm_s % $1 ))
+}
+
+pm_meta() {  # category key value
+    if [ -n "${PM_OUT:-}" ]; then
+        printf '%s,%s,%s\n' "$1" "$2" "$(printf '%s' "$3" | sed -e 's/"/""/g' -e 's/^/"/' -e 's/$/"/')" \
+            >> "${PM_OUT}/perf_meta.csv" 2>/dev/null
+    fi
+    return 0
+}
+
+# タイムスタンプのタイムゾーン。tzdata が無いイメージでも Asia/Tokyo は JST-9 で代替する。
+pm_setup_tz() {
+    case "${PERF_TZ}" in
+        "") ;;
+        UTC|utc) TZ=UTC0; export TZ ;;
+        JST|jst|Asia/Tokyo)
+            if [ -e /usr/share/zoneinfo/Asia/Tokyo ]; then TZ=Asia/Tokyo; else TZ=JST-9; fi
+            export TZ ;;
+        *) TZ="${PERF_TZ}"; export TZ ;;
+    esac
+}
+
+# JBoss EAP サーバー JVM の PID (java で、jboss-modules.jar と org.jboss.as.standalone を含む)
+pm_find_jboss_pid() {
+    for _pm_d in /proc/[0-9]*; do
+        [ -r "${_pm_d}/cmdline" ] || continue
+        _pm_c="$(tr '\0' ' ' 2>/dev/null < "${_pm_d}/cmdline")" || continue
+        case "${_pm_c}" in
+            *org.jboss.as.cli*) continue ;;
+            *jboss-modules.jar*org.jboss.as.standalone*) ;;
+            *) continue ;;
+        esac
+        _pm_a0="${_pm_c%% *}"
+        case "${_pm_a0##*/}" in
+            java|java.*) printf '%s\n' "${_pm_d#/proc/}"; return 0 ;;
+        esac
+    done
+    return 1
+}
+
+# JBoss の JVM が現れるまで待つ (PERF_WAIT_TIMEOUT 秒)。PM_JPID に入れる。
+pm_wait_jboss() {
+    _pm_dl=$(( $(date +%s) + PERF_WAIT_TIMEOUT ))
+    until PM_JPID="$(pm_find_jboss_pid)"; do
+        if [ "$(date +%s)" -ge "${_pm_dl}" ]; then
+            pm_log WARN "JBoss EAP の JVM が ${PERF_WAIT_TIMEOUT} 秒たっても見つかりません。この収集 (${PM_NAME}) を終了します"
+            return 1
+        fi
+        sleep 2
+    done
+}
+
+pm_jboss_alive() {
+    [ -n "${PM_JPID:-}" ] && [ -r "/proc/${PM_JPID}/cmdline" ] && \
+        tr '\0' ' ' 2>/dev/null < "/proc/${PM_JPID}/cmdline" | grep -q 'org.jboss.as.standalone'
+}
+
+# JBoss の JVM が使っている java の実体 (収集用の JVM も同じ JDK を使う)
+pm_java_of_jboss() {
+    _pm_j=""
+    if [ -n "${PM_JPID:-}" ]; then
+        _pm_j="$(readlink "/proc/${PM_JPID}/exe" 2>/dev/null)"
+    fi
+    if [ -z "${_pm_j}" ] || [ ! -x "${_pm_j}" ]; then
+        if [ -n "${JAVA_HOME:-}" ] && [ -x "${JAVA_HOME}/bin/java" ]; then
+            _pm_j="${JAVA_HOME}/bin/java"
+        else
+            _pm_j="$(command -v java 2>/dev/null)"
+        fi
+    fi
+    [ -n "${_pm_j}" ] || return 1
+    printf '%s\n' "${_pm_j}"
+}
+
+# 指定 PID とその子孫を止める
+pm_kill_tree() {  # pid
+    _pm_list=" $1 "
+    _pm_pass=0
+    while [ "${_pm_pass}" -lt 3 ]; do
+        for _pm_d in /proc/[0-9]*; do
+            _pm_st="$(cat "${_pm_d}/stat" 2>/dev/null)" || continue
+            _pm_st="${_pm_st##*) }"
+            # shellcheck disable=SC2086
+            set -- ${_pm_st}
+            case "${_pm_list}" in
+                *" $2 "*)
+                    case "${_pm_list}" in *" ${_pm_d#/proc/} "*) ;; *) _pm_list="${_pm_list}${_pm_d#/proc/} " ;; esac
+                    ;;
+            esac
+        done
+        _pm_pass=$((_pm_pass + 1))
+    done
+    # shellcheck disable=SC2086
+    kill -TERM ${_pm_list} 2>/dev/null
+    sleep 1
+    # shellcheck disable=SC2086
+    kill -KILL ${_pm_list} 2>/dev/null
+    return 0
+}
+
+# 作業ディレクトリの候補 (タスクローカルで書ける所)
+pm_work_candidates() {
+    [ -n "${PERF_WORK_DIR}" ] && printf '%s\n' "${PERF_WORK_DIR}"
+    printf '%s\n' "/tmp/perf-metrics"
+    printf '%s\n' "${JBOSS_HOME:-/opt/jboss-eap}/standalone/tmp/perf-metrics"
+    [ -n "${PM_OUT:-}" ] && printf '%s\n' "${PM_OUT}/.work"
+    return 0
+}
+
+# 状態ファイル (status / stop / pack が使う) を探して読み込む
+pm_load_state() {
+    for _pm_w in $(pm_work_candidates); do
+        if [ -r "${_pm_w}/perf-metrics.state" ]; then
+            # shellcheck disable=SC1090
+            . "${_pm_w}/perf-metrics.state"
+            return 0
+        fi
+    done
+    return 1
+}
+
+# =============================================================================
+# 起動 (efs-entrypoint.sh から呼ばれる)
+# =============================================================================
+# 出力先を決める。成功したら PM_OUT に入れる。
+pm_resolve_output_dir() {
+    PM_OUT=""
+    PM_OUT_NOTE=""
+    if [ -n "${PERF_OUTPUT_DIR}" ]; then
+        PM_OUT="${PERF_OUTPUT_DIR}"
+        PM_OUT_NOTE="PERF_OUTPUT_DIR で指定"
+    elif [ -n "${JBOSS_LOG_DIR:-}" ] && [ -d "${JBOSS_LOG_DIR}" ]; then
+        # エントリポイントが決めた、このタスク専用の実体ディレクトリ (mid/<LOG_ID>)
+        PM_OUT="${JBOSS_LOG_DIR}/perf"
+        PM_OUT_NOTE="JBoss のログと同じタスク専用ディレクトリ"
+    elif [ -n "${EFS_LOG_DIR:-}" ] && [ -d "${EFS_LOG_DIR}/mid/current" ]; then
+        # 起動時点の current を実体パスへ解決する (以後 current が張り替わっても影響しない)
+        _pm_cur="$(cd "${EFS_LOG_DIR}/mid/current" 2>/dev/null && pwd -P)"
+        [ -n "${_pm_cur}" ] && PM_OUT="${_pm_cur}/perf"
+        PM_OUT_NOTE="起動時点の mid/current を実体パスへ解決"
+    elif [ -d "${JBOSS_HOME:-/opt/jboss-eap}/standalone/log" ]; then
+        _pm_cur="$(cd "${JBOSS_HOME:-/opt/jboss-eap}/standalone/log" 2>/dev/null && pwd -P)"
+        [ -n "${_pm_cur}" ] && PM_OUT="${_pm_cur}/perf"
+        PM_OUT_NOTE="standalone/log の解決先"
+    fi
+    [ -n "${PM_OUT}" ] || return 1
+    mkdir -p "${PM_OUT}" 2>/dev/null
+    pm_is_writable "${PM_OUT}"
+}
+
+pm_resolve_work_dir() {
+    PM_W=""
+    for _pm_w in $(pm_work_candidates); do
+        mkdir -p "${_pm_w}" 2>/dev/null || continue
+        if pm_is_writable "${_pm_w}"; then PM_W="${_pm_w}"; return 0; fi
+    done
+    return 1
+}
+
+pm_banner_line() {
+    pm_say "$1"
+    [ -n "${PM_LOG_FILE:-}" ] && printf '%s [perf-metrics] [start] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$1" >> "${PM_LOG_FILE}" 2>/dev/null
+    return 0
+}
+
+pm_has_collector() {
+    case " ${PERF_COLLECTORS} " in *" $1 "*) return 0 ;; esac
+    return 1
+}
+
+perf_metrics_start() {
+    # エントリポイントの set -e / -u をこの関数の中だけ外す (収集側の都合で起動を止めない)
+    _pm_saved_flags="$-"
+    set +eu
+    PM_NAME=start
+    pm_start_body "$@"
+    _pm_rc=$?
+    case "${_pm_saved_flags}" in *e*) set -e ;; esac
+    case "${_pm_saved_flags}" in *u*) set -u ;; esac
+    return "${_pm_rc}"
+}
+
+pm_start_body() {
+    pm_setup_tz
+    PERF_INTERVAL="$(pm_uint_or "${PERF_INTERVAL}" 10)"
+    PERF_CLI_INTERVAL="$(pm_uint_or "${PERF_CLI_INTERVAL}" "${PERF_INTERVAL}")"
+    PERF_JSTAT_INTERVAL="$(pm_uint_or "${PERF_JSTAT_INTERVAL}" "${PERF_INTERVAL}")"
+    PERF_CLI_TIMEOUT="$(pm_uint_or "${PERF_CLI_TIMEOUT}" 30)"
+    PERF_WAIT_TIMEOUT="$(pm_uint_or "${PERF_WAIT_TIMEOUT}" 900)"
+
+    if ! pm_resolve_output_dir; then
+        pm_say "WARN: 出力先 '${PM_OUT:-(決められません)}' に書き込めないため、性能試験用メトリクス収集を行いません (JBoss は起動します)" >&2
+        pm_say "WARN: JBOSS_LOG_DIR='${JBOSS_LOG_DIR:-}' EFS_LOG_DIR='${EFS_LOG_DIR:-}' PERF_OUTPUT_DIR='${PERF_OUTPUT_DIR}'" >&2
+        return 1
+    fi
+    if ! pm_resolve_work_dir; then
+        pm_say "WARN: 作業ディレクトリ (/tmp・standalone/tmp・出力先/.work) に書き込めないため、収集を行いません" >&2
+        return 1
+    fi
+    rm -f "${PM_W}"/cli.in "${PM_W}"/cli.out "${PM_W}"/*.pid "${PM_W}/perf-metrics.state" 2>/dev/null
+    PM_LOG_FILE="${PM_OUT}/collector.log"
+    PM_SELF="${PERF_METRICS_SCRIPT:-${PM_SELF}}"
+
+    # 収集プロセスへ渡す値
+    export PM_OUT PM_W PM_LOG_FILE TZ PERF_CLI_INTERVAL PERF_JSTAT_INTERVAL PERF_CLI_ENABLE_DS_STATS \
+        PERF_CLI_CONTROLLER PERF_CLI_USER PERF_CLI_PASSWORD PERF_CLI_TIMEOUT PERF_CLI_HEAP PERF_WAIT_TIMEOUT
+
+    # 収集条件 (レポートの「収集情報」に出る)
+    pm_now
+    pm_meta perf version "${PERF_METRICS_VERSION}"
+    pm_meta perf start_time "${PM_TS}"
+    pm_meta perf start_epoch "${PM_EPOCH}"
+    pm_meta perf utc_offset "$(date +%z)"
+    pm_meta perf output_dir "${PM_OUT}"
+    pm_meta perf collectors "${PERF_COLLECTORS}"
+    pm_meta perf cli_interval "${PERF_CLI_INTERVAL}"
+    pm_meta perf jstat_interval "${PERF_JSTAT_INTERVAL}"
+    pm_meta perf statistics_opts "${PERF_SERVER_OPTS}"
+    pm_meta container hostname "$(cat /proc/sys/kernel/hostname 2>/dev/null)"
+    pm_meta container service_name "${Service_Name:-}"
+    pm_meta container component_name "${Component_name:-}"
+    pm_meta container log_id "$(basename "$(dirname "${PM_OUT}")")"
+    pm_meta container command "$(printf '%s ' "$@" | sed "${PM_MASK_SED}")"
+
+    {
+        echo "PM_OUT='${PM_OUT}'"
+        echo "PM_W='${PM_W}'"
+        echo "PM_LOG_FILE='${PM_LOG_FILE}'"
+        echo "PM_START_TS='${PM_TS}'"
+    } > "${PM_W}/perf-metrics.state" 2>/dev/null
+
+    # 有効であることを起動ログで分かるようにする
+    _pm_off() { pm_has_collector "$1" || printf ' (無効)'; }
+    pm_banner_line "======================================================================"
+    pm_banner_line " 性能試験用メトリクス収集: 有効  (perf-metrics.sh ${PERF_METRICS_VERSION} / PERF_METRICS_ENABLED=true)"
+    pm_banner_line " 出力先 : ${PM_OUT}"
+    pm_banner_line "          (${PM_OUT_NOTE}。最後に起動したタスクは mid/current/perf から辿れます)"
+    pm_banner_line " ① jboss-cli : ${PERF_CLI_INTERVAL} 秒間隔$(_pm_off cli)  DB 接続プール (cli_datasource.csv)・スレッド数 (jvm_threads.csv)"
+    pm_banner_line " ② jstat     : ${PERF_JSTAT_INTERVAL} 秒間隔$(_pm_off jstat)  ヒープ・GC (jvm_jstat_gc.csv)"
+    if [ -n "${PERF_SERVER_OPTS}" ]; then
+        pm_banner_line " 統計の有効化: ${PERF_SERVER_OPTS} を standalone.sh へ追加"
+    fi
+    pm_banner_line " 作業ディレクトリ: ${PM_W}   状態確認: perf-metrics.sh status (ECS Exec で実行)"
+    pm_banner_line " ※ 性能試験用のイメージです。本番は PERF_METRICS_ENABLED=false でビルドしてください"
+    pm_banner_line "======================================================================"
+
+    # 前提の確認 (足りないものは警告し、その収集だけ止まる)
+    if pm_has_collector cli && [ ! -f "${JBOSS_HOME:-/opt/jboss-eap}/bin/jboss-cli.sh" ]; then
+        pm_say "WARN: ${JBOSS_HOME:-/opt/jboss-eap}/bin/jboss-cli.sh がありません。① の取得は行いません" >&2
+    fi
+    if pm_has_collector jstat && ! pm_is_writable /tmp; then
+        pm_say "WARN: /tmp に書き込めないため jstat は JVM の性能カウンタ (hsperfdata) を読めません。" >&2
+        pm_say "WARN: タスク定義で /tmp に書き込み可能ボリュームを当ててください (① DB 接続プールは取得できます)" >&2
+    fi
+
+    # 収集プロセスを起動 (JBoss の起動とは並行して動き、JVM の出現を待ってから取得する)
+    for _pm_c in ${PERF_COLLECTORS}; do
+        case "${_pm_c}" in
+            cli|jstat) ;;
+            *) pm_say "WARN: PERF_COLLECTORS の不明な値を無視します: ${_pm_c}" >&2; continue ;;
+        esac
+        /bin/sh "${PM_SELF}" run "${_pm_c}" < /dev/null > /dev/null &
+        echo "$!" > "${PM_W}/${_pm_c}.pid" 2>/dev/null
+        pm_log INFO "収集プロセスを起動しました: ${_pm_c} (pid=$!)"
+    done
+    return 0
+}
+
+# =============================================================================
+# ① jboss-cli : DB 接続プール・スレッド数
+# =============================================================================
+# jboss-cli は常駐セッション (FIFO で命令を送る) を 1 つだけ起動し、間隔ごとに JVM を
+# 起動し直すことはしない (起動のたびに CPU を 1 秒以上使うため)。取得は管理モデルの
+# 読み取りだけ。各操作は try / catch で囲み、失敗しても後の操作は続ける。
+
+PM_DS_POOL_COLS="ActiveCount,AvailableCount,InUseCount,IdleCount,MaxUsedCount,WaitCount,MaxWaitCount,BlockingFailureCount,TimedOut,CreatedCount,DestroyedCount,AverageGetTime,MaxGetTime,TotalGetTime,AverageBlockingTime,MaxWaitTime,TotalBlockingTime,AverageUsageTime,MaxUsageTime,TotalUsageTime,AverageCreationTime,MaxCreationTime,TotalCreationTime,AveragePoolTime,MaxPoolTime,TotalPoolTime"
+PM_DS_HEADER="timestamp,epoch,ds_type,ds_name,jndi_name,statistics_enabled,min_pool_size,max_pool_size,blocking_timeout_ms,${PM_DS_POOL_COLS}"
+PM_THR_HEADER="timestamp,epoch,pid,live_threads,os_threads"
+
+# 応答 (DMR 形式) をデータソース 1 つにつき 1 行の CSV にする。
+# 応答は「PERF_B <ds|xa>.pool」「PERF_B <ds|xa>.attr.<属性名>」で区切られ、ワイルドカードの
+# 各要素は address (データソース名) → result の順に並ぶ。プール統計は result の中の
+# 1 段下の行だけを読む。未定義 (undefined) の属性は要素ごと省かれるため空欄になる。
+PM_DS_AWK='
+function norm(v) {
+  sub(/,$/, "", v)
+  if (v == "undefined") return ""
+  if (v ~ /^-?[0-9]+L$/) return substr(v, 1, length(v) - 1)
+  if (v ~ /^".*"$/) { v = substr(v, 2, length(v) - 2); gsub(/\\"/, "\"", v) }
+  return v
+}
+function csvq(s) { if (s ~ /[",]/) { gsub(/"/, "\"\"", s); return "\"" s "\"" } return s }
+function get(k) { return ((ty, nm, k) in V) ? V[ty, nm, k] : "" }
+BEGIN { nc = split(cols, C, ",") }
+/^PERF_B / { split($2, b, "."); ty = b[1]; kind = b[2]; attr = b[3]; nm = ""; ind = -1; next }
+/^PERF_/ { ty = ""; next }
+ty == "" { next }
+/^ *\("(xa-)?data-source" => "/ {
+  nm = $0; sub(/^[^>]*> "/, "", nm); sub(/"\),?$/, "", nm); ind = -1
+  if (!((ty, nm) in SEEN)) { SEEN[ty, nm] = 1; ORD[++N] = ty SUBSEP nm }
+  next
+}
+nm == "" { next }
+/^ *"result" => / {
+  v = $0; sub(/^ *"result" => /, "", v)
+  if (v == "{") { match($0, /^ */); ind = RLENGTH + 4 }
+  else if (kind == "attr") V[ty, nm, attr] = norm(v)
+  next
+}
+kind == "pool" && ind >= 0 && /^ *"[^"]*" => / {
+  match($0, /^ */); if (RLENGTH != ind) next
+  k = substr($0, ind + 2); v = k; sub(/".*/, "", k); sub(/^[^"]*" => /, "", v)
+  V[ty, nm, k] = norm(v)
+}
+END {
+  for (i = 1; i <= N; i++) {
+    split(ORD[i], e, SUBSEP); ty = e[1]; nm = e[2]
+    if (get("InUseCount") == "") continue
+    row = ts "," epoch "," ty "," csvq(nm) "," csvq(get("jndi-name")) "," get("statistics-enabled") \
+      "," get("min-pool-size") "," get("max-pool-size") "," get("blocking-timeout-wait-millis")
+    for (j = 1; j <= nc; j++) row = row "," get(C[j])
+    print row >> out
+    if (enlist != "" && get("statistics-enabled") == "false")
+      print (ty == "xa" ? "xa-data-source" : "data-source") "\t" nm > enlist
+  }
+}
+'
+
+pm_cli_q() {  # id operation
+    printf 'echo PERF_B %s\ntry\n%s\ncatch\necho PERF_F %s\nend-try\n' "$1" "$2" "$1"
+}
+
+pm_cli_quote() {
+    case "$1" in
+        *[!A-Za-z0-9_.-]*) printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')" ;;
+        *) printf '%s' "$1" ;;
+    esac
+}
+
+# 1 回分の問い合わせ: プール統計と、使用率の計算に使う設定 (パスワード等を読まないよう属性ごと)、
+# 最後にライブスレッド数 (OS スレッド数を読む直前に取るため最後に置く)
+pm_cli_sample_block() {
+    for _pm_t in ds xa; do
+        if [ "${_pm_t}" = ds ]; then _pm_r=data-source; else _pm_r=xa-data-source; fi
+        pm_cli_q "${_pm_t}.pool" "/subsystem=datasources/${_pm_r}=*/statistics=pool:read-resource(include-runtime=true)"
+        for _pm_a in jndi-name min-pool-size max-pool-size blocking-timeout-wait-millis; do
+            pm_cli_q "${_pm_t}.attr.${_pm_a}" "/subsystem=datasources/${_pm_r}=*:read-attribute(name=${_pm_a},resolve-expressions=true)"
+        done
+    done
+    pm_cli_q thr.live "/core-service=platform-mbean/type=threading:read-attribute(name=thread-count)"
+}
+
+# スレッド数を 1 行書く。jboss-cli が応答しなかった回もライブスレッド数を空欄にして書く
+# (スレッドが枯渇して管理インタフェースが応答しないときこそ OS スレッド数が手がかりになるため)。
+#   live_threads : JVM が数える Java のスレッド数 (platform-mbean の thread-count。デーモンを含む)
+#   os_threads   : カーネルから見た JBoss プロセスのスレッド数 (/proc/<pid>/status の Threads)。
+#                  GC・JIT コンパイラなど JVM 内部のスレッドも含むため、ライブスレッド数より多い
+pm_threads_row() {
+    _pm_live="$(awk '/^PERF_B /{b=$2; next} /^PERF_/{b=""; next} b=="thr.live" && /^ *"result" => [0-9]/{sub(/^ *"result" => /, ""); print; exit}' "${PM_W}/cli.out" 2>/dev/null)"
+    pm_jboss_alive || PM_JPID="$(pm_find_jboss_pid)" || return 0
+    _pm_os="$(sed -n 's/^Threads:[[:space:]]*//p' "/proc/${PM_JPID}/status" 2>/dev/null)"
+    printf '%s,%s,%s,%s,%s\n' "${PM_TS}" "${PM_EPOCH}" "${PM_JPID}" "${_pm_live}" "${_pm_os}" >> "${PM_OUT}/jvm_threads.csv"
+}
+
+# jboss-cli.sh を、サーバーと同じ java・小さなヒープで起動する (サブシェルから exec)
+pm_cli_exec() {  # cli-file
+    unset JAVA_TOOL_OPTIONS _JAVA_OPTIONS JDK_JAVA_OPTIONS
+    # 先頭の -Dperf.metrics.collector は目印 (ps で手動実行の jboss-cli と区別するため)
+    JAVA_OPTS="-Dperf.metrics.collector=jboss-cli -Xms16m -Xmx${PERF_CLI_HEAP} ${PM_JVM_OPTS} -XX:ReservedCodeCacheSize=32m -Djava.awt.headless=true"
+    export JAVA_OPTS JBOSS_HOME
+    [ -n "${PM_CLI_JAVA:-}" ] && { JAVA="${PM_CLI_JAVA}"; export JAVA; }
+    set -- --connect "--controller=${PM_CLI_CTRL}" "--timeout=15000" "--command-timeout=${PERF_CLI_TIMEOUT}" "--file=$1"
+    [ -n "${PERF_CLI_USER}" ] && set -- "$@" "--user=${PERF_CLI_USER}"
+    [ -n "${PERF_CLI_PASSWORD}" ] && set -- "$@" "--password=${PERF_CLI_PASSWORD}"
+    exec "${PM_CLI}" "$@"
+}
+
+# サーバーの起動引数から JBOSS_HOME・管理インタフェースのアドレス / ポートを読む
+pm_cli_resolve() {
+    JBOSS_HOME="${JBOSS_HOME:-}"
+    _pm_addr=""; _pm_port=""; _pm_off=0; _pm_prev=""
+    if [ -r "/proc/${PM_JPID}/cmdline" ]; then
+        _pm_oifs="${IFS}"; IFS='
+'
+        for _pm_a in $(tr '\0' '\n' 2>/dev/null < "/proc/${PM_JPID}/cmdline"); do
+            case "${_pm_a}" in
+                -Djboss.home.dir=*) [ -z "${JBOSS_HOME}" ] && JBOSS_HOME="${_pm_a#*=}" ;;
+                -Djboss.bind.address.management=*|-bmanagement=*) _pm_addr="${_pm_a#*=}" ;;
+                -Djboss.management.http.port=*) _pm_port="${_pm_a#*=}" ;;
+                -Djboss.socket.binding.port-offset=*) _pm_off="${_pm_a#*=}" ;;
+            esac
+            [ "${_pm_prev}" = "-bmanagement" ] && _pm_addr="${_pm_a}"
+            _pm_prev="${_pm_a}"
+        done
+        IFS="${_pm_oifs}"
+    fi
+    JBOSS_HOME="${JBOSS_HOME:-/opt/jboss-eap}"
+    PM_CLI="${JBOSS_HOME}/bin/jboss-cli.sh"
+    [ -f "${PM_CLI}" ] || return 1
+    _pm_port="$(pm_uint_or "${_pm_port}" 9990)"
+    case "${_pm_off}" in ""|*[!0-9]*) _pm_off=0 ;; esac
+    case "${_pm_addr}" in ""|0.0.0.0|::|"[::]"|localhost) _pm_addr=127.0.0.1 ;; esac
+    PM_CLI_CTRL="${PERF_CLI_CONTROLLER:-remote+http://${_pm_addr}:$(( _pm_port + _pm_off ))}"
+    PM_CLI_JAVA="$(pm_java_of_jboss)" || PM_CLI_JAVA=""
+    return 0
+}
+
+pm_cli_alive() { [ -n "${PM_CLI_PID:-}" ] && kill -0 "${PM_CLI_PID}" 2>/dev/null; }
+
+pm_cli_stop() {
+    if [ "${PM_CLI_FD:-0}" = 1 ]; then
+        printf 'quit\n' >&7 2>/dev/null
+        exec 7>&-
+        PM_CLI_FD=0
+    fi
+    if pm_cli_alive; then
+        sleep 1
+        pm_cli_alive && pm_kill_tree "${PM_CLI_PID}"
+    fi
+    [ -n "${PM_CLI_PID:-}" ] && wait "${PM_CLI_PID}" 2>/dev/null
+    PM_CLI_PID=""
+    rm -f "${PM_W}/cli.in" 2>/dev/null
+    return 0
+}
+
+# 目印の行が出るまで待つ。0=出た 1=CLI が終了した 2=タイムアウト
+pm_cli_wait() {  # marker timeout
+    _pm_dl=$(( $(date +%s) + $2 ))
+    while :; do
+        grep -qx "$1" "${PM_W}/cli.out" 2>/dev/null && return 0
+        pm_cli_alive || return 1
+        [ "$(date +%s)" -ge "${_pm_dl}" ] && return 2
+        sleep 0.2 2>/dev/null || sleep 1
+    done
+}
+
+pm_cli_start() {
+    pm_cli_stop
+    : > "${PM_W}/cli.out" || return 1
+    mkfifo -m 600 "${PM_W}/cli.in" 2>/dev/null || return 1
+    ( pm_cli_exec "${PM_W}/cli.in" ) >> "${PM_W}/cli.out" 2>> "${PM_W}/cli.err" < /dev/null &
+    PM_CLI_PID=$!
+    # FIFO を読み書き両用で開いておく (CLI が EOF を受けて終わらないように)
+    exec 7<> "${PM_W}/cli.in" || { pm_cli_stop; return 1; }
+    PM_CLI_FD=1
+    printf 'echo PERF_READY\n' >&7
+    if ! pm_cli_wait PERF_READY 60; then
+        pm_cli_stop
+        return 1
+    fi
+    pm_log INFO "jboss-cli の常駐セッションを開始しました (pid=${PM_CLI_PID}, ${PM_CLI_CTRL})"
+    return 0
+}
+
+# 1 回分の問い合わせ。応答が最後まで揃えば 0。
+pm_cli_exchange() {  # seq block-file
+    : > "${PM_W}/cli.out"
+    pm_cli_alive || return 1
+    { printf 'echo PERF_S %s\n' "$1"; cat "$2"; printf 'echo PERF_E %s\n' "$1"; } >&7 2>/dev/null || return 1
+    pm_cli_wait "PERF_E $1" "${PERF_CLI_TIMEOUT}"
+    case $? in
+        0) return 0 ;;
+        2) pm_log WARN "jboss-cli が ${PERF_CLI_TIMEOUT} 秒以内に応答しません。セッションを作り直します" ;;
+    esac
+    pm_cli_stop
+    return 1
+}
+
+# プール統計が無効なデータソースを実行時に有効化する (statistics=pool の実行時属性)
+pm_cli_enable_stats() {  # seq
+    : > "${PM_W}/enable.cli"
+    while IFS="$(printf '\t')" read -r _pm_ty _pm_dn; do
+        [ -n "${_pm_dn}" ] || continue
+        pm_cli_q en "/subsystem=datasources/${_pm_ty}=$(pm_cli_quote "${_pm_dn}")/statistics=pool:write-attribute(name=statistics-enabled,value=true)" \
+            >> "${PM_W}/enable.cli"
+        pm_log INFO "データソース ${_pm_dn} のプール統計を実行時に有効化します (設定ファイルは変えません)"
+    done < "${PM_W}/cli.enable"
+    if pm_cli_exchange "$1" "${PM_W}/enable.cli"; then
+        [ -n "${PM_EN_META:-}" ] || pm_meta cli ds_stats_enabled_at_runtime "$(date '+%Y-%m-%d %H:%M:%S')"
+        PM_EN_META=1
+    else
+        pm_log WARN "データソースのプール統計を有効化できませんでした"
+    fi
+}
+
+pm_run_cli() {
+    PM_NAME=cli
+    PM_CLI_FD=0; PM_CLI_PID=""
+    trap 'pm_cli_stop; exit 0' TERM INT
+    pm_wait_jboss || exit 0
+    if ! pm_cli_resolve; then
+        pm_log WARN "jboss-cli.sh が見つかりません (JBOSS_HOME=${JBOSS_HOME:-})。① の取得を終了します"
+        exit 0
+    fi
+    pm_cli_sample_block > "${PM_W}/sample.cli"
+    _pm_csv="${PM_OUT}/cli_datasource.csv"
+    [ -s "${_pm_csv}" ] || printf '%s\n' "${PM_DS_HEADER}" >> "${_pm_csv}"
+    [ -s "${PM_OUT}/jvm_threads.csv" ] || printf '%s\n' "${PM_THR_HEADER}" >> "${PM_OUT}/jvm_threads.csv"
+    _pm_en=""
+    [ "${PERF_CLI_ENABLE_DS_STATS}" = "true" ] && _pm_en="${PM_W}/cli.enable"
+    pm_meta cli controller "${PM_CLI_CTRL}"
+    pm_log INFO "① jboss-cli: ${PERF_CLI_INTERVAL} 秒間隔 (${PM_CLI_CTRL})"
+    _pm_seq=0; _pm_fail=0; _pm_en_last=0; _pm_retry=5
+    _pm_conn_dl=$(( $(date +%s) + PERF_WAIT_TIMEOUT ))
+    while :; do
+        if ! pm_cli_alive && ! pm_cli_start; then
+            if [ "$(date +%s)" -ge "${_pm_conn_dl}" ]; then
+                pm_warn_once noconn "管理インタフェース (${PM_CLI_CTRL}) に ${PERF_WAIT_TIMEOUT} 秒たっても接続できません。60 秒ごとに再試行します。詳細: ${PM_W}/cli.err"
+                _pm_retry=60
+            fi
+            # 接続できない間も OS スレッド数は記録する (ライブスレッド数は空欄)
+            pm_now
+            pm_threads_row
+            sleep "${_pm_retry}"
+            continue
+        fi
+        pm_now
+        _pm_seq=$((_pm_seq + 1))
+        rm -f "${PM_W}/cli.enable"
+        # jboss-cli はサーバーの再起動後に自分で再接続する。その間の操作は catch 側 (PERF_F) に入る
+        if pm_cli_exchange "${_pm_seq}" "${PM_W}/sample.cli" && ! grep -q '^PERF_F ds\.pool$' "${PM_W}/cli.out"; then
+            awk -v ts="${PM_TS}" -v epoch="${PM_EPOCH}" -v cols="${PM_DS_POOL_COLS}" -v out="${_pm_csv}" -v enlist="${_pm_en}" \
+                "${PM_DS_AWK}" "${PM_W}/cli.out" 2>> "${PM_W}/cli.err"
+            [ "${_pm_fail}" -gt 0 ] && pm_log INFO "① jboss-cli の取得を再開しました (失敗 ${_pm_fail} 回)"
+            _pm_fail=0
+        else
+            _pm_fail=$((_pm_fail + 1))
+            [ "${_pm_fail}" = 1 ] && pm_log WARN "① jboss-cli の取得に失敗しました (seq=${_pm_seq})。続けて試します。詳細: ${PM_W}/cli.err"
+        fi
+        pm_threads_row
+        # プール統計が無効なデータソースは実行時に有効化する (60 秒に 1 回まで)
+        if [ -s "${PM_W}/cli.enable" ] && [ $(( PM_EPOCH - _pm_en_last )) -ge 60 ]; then
+            _pm_en_last="${PM_EPOCH}"
+            _pm_seq=$((_pm_seq + 1))
+            pm_cli_enable_stats "${_pm_seq}"
+        fi
+        pm_sleep_tick "${PERF_CLI_INTERVAL}"
+    done
+}
+
+# =============================================================================
+# ② jstat -gc
+# =============================================================================
+# jstat は「間隔」を指定して 1 つだけ常駐させ、出力の各行に時刻を付けて CSV にする。
+# 起動方法 (JBoss と同じ JDK を使う):
+#   1) JBoss の java と同じ bin の jstat  2) PATH の jstat  3) java -m jdk.jcmd/sun.tools.jstat.Jstat
+#   (Red Hat の OpenJDK 21 runtime イメージには jstat が無いが、jdk.jcmd モジュールはある)
+pm_resolve_jstat() {
+    PM_JSTAT=""
+    PM_JSTAT_JAVA="$(pm_java_of_jboss)" || PM_JSTAT_JAVA=""
+    if [ -n "${PM_JSTAT_JAVA}" ]; then
+        _pm_jb="$(readlink -f "${PM_JSTAT_JAVA}" 2>/dev/null || printf '%s' "${PM_JSTAT_JAVA}")"
+        if [ -x "${_pm_jb%/java}/jstat" ]; then PM_JSTAT="${_pm_jb%/java}/jstat"; return 0; fi
+    fi
+    if command -v jstat >/dev/null 2>&1; then PM_JSTAT="$(command -v jstat)"; return 0; fi
+    [ -n "${PM_JSTAT_JAVA}" ] && \
+        env -u JAVA_TOOL_OPTIONS -u _JAVA_OPTIONS -u JDK_JAVA_OPTIONS "${PM_JSTAT_JAVA}" -XX:-UsePerfData --list-modules 2>/dev/null \
+        | grep -q '^jdk\.jcmd@'
+}
+
+pm_jstat_desc() {
+    if [ -n "${PM_JSTAT}" ]; then printf '%s' "${PM_JSTAT}"; else printf '%s -m jdk.jcmd/sun.tools.jstat.Jstat' "${PM_JSTAT_JAVA}"; fi
+}
+
+# jstat -gc -t <pid> <間隔> を、アプリ用の JVM オプション (javaagent 等) を外して起動する (サブシェルから exec)
+pm_jstat_exec() {
+    unset JAVA_TOOL_OPTIONS _JAVA_OPTIONS JDK_JAVA_OPTIONS JAVA_OPTS
+    LC_ALL=C; export LC_ALL
+    # 先頭の -Dperf.metrics.collector は目印 (ps で手動実行の jstat と区別するため)
+    _pm_o="-Dperf.metrics.collector=jstat -Xms8m -Xmx32m ${PM_JVM_OPTS}"
+    if [ -n "${PM_JSTAT}" ]; then
+        _pm_jo=""
+        for _pm_x in ${_pm_o}; do _pm_jo="${_pm_jo} -J${_pm_x}"; done
+        # shellcheck disable=SC2086
+        exec "${PM_JSTAT}" ${_pm_jo} -gc -t "${PM_JPID}" "${PERF_JSTAT_INTERVAL}s"
+    fi
+    # shellcheck disable=SC2086
+    exec "${PM_JSTAT_JAVA}" ${_pm_o} -m jdk.jcmd/sun.tools.jstat.Jstat -gc -t "${PM_JPID}" "${PERF_JSTAT_INTERVAL}s"
+}
+
+# jstat の出力 (空白区切り・先頭列が JVM の稼働秒) を、時刻付きの CSV にする
+pm_jstat_csv() {  # csv-file
+    _pm_f="$1"
+    set -f
+    while IFS= read -r _pm_l; do
+        # shellcheck disable=SC2086
+        set -- ${_pm_l}
+        case "${1:-}" in
+            Timestamp)
+                shift
+                [ -s "${_pm_f}" ] || ( IFS=,; printf 'timestamp,epoch,uptime_s,%s\n' "$*" ) >> "${_pm_f}"
+                ;;
+            [0-9]*)
+                pm_now
+                ( IFS=,; printf '%s,%s,%s\n' "${PM_TS}" "${PM_EPOCH}" "$*" ) >> "${_pm_f}"
+                ;;
+        esac
+    done
+    set +f
+}
+
+# hsperfdata (jstat が読む性能カウンタ) が /tmp にあるか
+pm_hsperf_exists() {  # pid
+    for _pm_h in /tmp/hsperfdata_*/"$1"; do
+        [ -e "${_pm_h}" ] && return 0
+    done
+    return 1
+}
+
+pm_run_jstat() {
+    PM_NAME=jstat
+    trap 'exit 0' TERM INT
+    pm_wait_jboss || exit 0
+    if ! pm_resolve_jstat; then
+        pm_log WARN "② jstat を起動できません (jstat が無く、java に jdk.jcmd モジュールもありません)"
+        exit 0
+    fi
+    pm_meta jvm jstat_command "$(pm_jstat_desc)"
+    _pm_miss=0
+    while :; do
+        pm_jboss_alive || PM_JPID="$(pm_find_jboss_pid)" || { sleep 5; continue; }
+        if ! pm_hsperf_exists "${PM_JPID}"; then
+            # JVM の起動直後はまだ無いことがあるため、30 秒続けて無いときだけ警告する
+            _pm_miss=$((_pm_miss + 1))
+            [ "${_pm_miss}" -ge 3 ] && pm_warn_once "hsperf${PM_JPID}" "② jstat: JVM の性能カウンタ (/tmp/hsperfdata_*/${PM_JPID}) がありません。/tmp が書き込めない、または JBoss に -XX:-UsePerfData / -XX:+PerfDisableSharedMem が指定されています"
+            sleep 10
+            continue
+        fi
+        _pm_miss=0
+        pm_log INFO "② jstat -gc を開始します (pid=${PM_JPID}, ${PERF_JSTAT_INTERVAL} 秒間隔, $(pm_jstat_desc))"
+        ( pm_jstat_exec ) 2>> "${PM_W}/jstat.err" | pm_jstat_csv "${PM_OUT}/jvm_jstat_gc.csv"
+        pm_log INFO "② jstat -gc が終了しました。5 秒後に再開します (JVM の再起動・停止の可能性)"
+        sleep 5
+    done
+}
+
+# =============================================================================
+# ビルド時の確認 / 運用コマンド
+# =============================================================================
+pm_install() {
+    pm_say "ビルド時の確認 (perf-metrics.sh ${PERF_METRICS_VERSION})"
+    if ! command -v awk > /dev/null 2>&1; then
+        if command -v microdnf > /dev/null 2>&1; then
+            microdnf install -y --nodocs gawk && microdnf clean all
+        elif command -v dnf > /dev/null 2>&1; then
+            dnf install -y --nodocs gawk && dnf clean all
+        fi
+        rm -rf /var/cache/yum /var/cache/dnf 2>/dev/null
+    fi
+    for _pm_t in awk mkfifo; do
+        if command -v "${_pm_t}" > /dev/null 2>&1; then pm_say "  ${_pm_t}: $(command -v "${_pm_t}")"; else pm_say "  ${_pm_t}: なし (収集は動きません)"; fi
+    done
+    if pm_resolve_jstat; then pm_say "  jstat: $(pm_jstat_desc)"; else pm_say "  jstat: なし (② は動きません)"; fi
+    if [ -f "${JBOSS_HOME:-/opt/jboss-eap}/bin/jboss-cli.sh" ]; then
+        pm_say "  jboss-cli.sh: ${JBOSS_HOME:-/opt/jboss-eap}/bin/jboss-cli.sh"
+    else
+        pm_say "  jboss-cli.sh: なし (JBoss EAP 導入前のイメージでは正常。① は実行時に JBOSS_HOME から探します)"
+    fi
+    pm_say "性能試験用メトリクス収集を有効にしました (PERF_METRICS_ENABLED=true)"
+    return 0
+}
+
+pm_status() {
+    if ! pm_load_state; then
+        echo "perf-metrics: 実行中の収集が見つかりません (PERF_METRICS_ENABLED=${PERF_METRICS_ENABLED})"
+        return 1
+    fi
+    echo "perf-metrics ${PERF_METRICS_VERSION}"
+    echo "  出力先          : ${PM_OUT}"
+    echo "  作業ディレクトリ: ${PM_W}"
+    echo "  開始            : ${PM_START_TS}"
+    for _pm_c in cli jstat; do
+        [ -r "${PM_W}/${_pm_c}.pid" ] || continue
+        _pm_p="$(cat "${PM_W}/${_pm_c}.pid")"
+        if kill -0 "${_pm_p}" 2>/dev/null; then _pm_s="実行中"; else _pm_s="停止"; fi
+        echo "  収集 ${_pm_c}: ${_pm_s} (pid=${_pm_p})"
+    done
+    echo "  ファイル (行数 / 最終行の時刻):"
+    for _pm_f in "${PM_OUT}/cli_datasource.csv" "${PM_OUT}/jvm_threads.csv" "${PM_OUT}/jvm_jstat_gc.csv"; do
+        [ -f "${_pm_f}" ] || continue
+        printf '    %-20s %8s  %s\n' "$(basename "${_pm_f}")" "$(wc -l < "${_pm_f}" | tr -d ' ')" "$(tail -n 1 "${_pm_f}" | cut -d, -f1 | tr -d '"')"
+    done
+    echo "  直近のログ:"
+    tail -n 5 "${PM_LOG_FILE}" 2>/dev/null | sed 's/^/    /'
+    return 0
+}
+
+pm_stop() {
+    pm_load_state || { echo "perf-metrics: 実行中の収集が見つかりません"; return 1; }
+    for _pm_c in cli jstat; do
+        [ -r "${PM_W}/${_pm_c}.pid" ] || continue
+        _pm_p="$(cat "${PM_W}/${_pm_c}.pid")"
+        if kill -0 "${_pm_p}" 2>/dev/null; then
+            pm_kill_tree "${_pm_p}"
+            echo "停止しました: ${_pm_c} (pid=${_pm_p})"
+        fi
+    done
+    PM_NAME=stop
+    pm_log INFO "perf-metrics.sh stop で収集を停止しました"
+    return 0
+}
+
+pm_pack() {
+    pm_load_state || { echo "perf-metrics: 出力先が分かりません (PERF_OUTPUT_DIR を指定してください)"; return 1; }
+    _pm_par="$(dirname "${PM_OUT}")"
+    _pm_tgz="${_pm_par}/perf_$(basename "${_pm_par}")_$(date '+%Y%m%d_%H%M%S').tar"
+    if command -v gzip > /dev/null 2>&1; then
+        tar -C "${_pm_par}" -czf "${_pm_tgz}.gz" "$(basename "${PM_OUT}")" && echo "${_pm_tgz}.gz"
+    else
+        tar -C "${_pm_par}" -cf "${_pm_tgz}" "$(basename "${PM_OUT}")" && echo "${_pm_tgz}"
+    fi
+}
+
+pm_main() {
+    _pm_cmd="${1:-}"
+    [ "$#" -gt 0 ] && shift
+    PM_SELF="$0"
+    pm_setup_tz
+    case "${_pm_cmd}" in
+        run)
+            case "${1:-}" in
+                cli) pm_run_cli ;;
+                jstat) pm_run_jstat ;;
+                *) echo "usage: perf-metrics.sh run cli|jstat" >&2; exit 2 ;;
+            esac
+            ;;
+        install) pm_install ;;
+        status) pm_status ;;
+        stop) pm_stop ;;
+        pack) pm_pack ;;
+        start) perf_metrics_start "$@" ;;
+        version) echo "perf-metrics.sh ${PERF_METRICS_VERSION}" ;;
+        *)
+            echo "usage: perf-metrics.sh status | stop | pack | install | version" >&2
+            exit 2
+            ;;
+    esac
+}
+
+# 直接実行されたときだけコマンドを処理する (エントリポイントから . で読み込まれたときは
+# 関数の定義だけで終わる)
+case "${0##*/}" in
+    perf-metrics.sh|perf-metrics) pm_main "$@"; exit $? ;;
+esac
+:
